# LiveKit configuration (injected automatically on LiveKit Cloud)
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_api_key
LIVEKIT_API_SECRET=your_api_secret

# Google Gemini (main agent LLM, via the LiveKit Google plugin)
GOOGLE_API_KEY=your_google_ai_studio_key

# Web search (Gemini + Google Search grounding)
# WEB_API_KEY is the primary key; GOOGLE_API_KEY_2 is used as a fallback
WEB_API_KEY=your_web_search_api_key
GOOGLE_API_KEY_2=your_secondary_google_key

# Groq (post-call summarization)
GROQ_API_KEY_2=your_groq_api_key

# Cartesia (text-to-speech)
CARTESIA_API_KEY=your_cartesia_api_key

# Deepgram (speech-to-text)
DEEPGRAM_API_KEY=your_deepgram_api_key
